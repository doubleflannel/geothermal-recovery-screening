# Public packet safety rails.
# This folder is intended to become a separate public GitHub repo.

# Raw or large scientific data must never be copied into the public packet.
data_external/
external/
raw/
raw_data/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.h5
*.hdf5
*.las
*.xlsx
*.xls
*.csv
*.parquet
*.feather
*.nc
*.mat

# Private repo/workflow state.
backlog/
.codex/
notes/private/
*.log
.DS_Store
.env
.env.*
*.secret
*.key

# Build/cache outputs.
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
node_modules/

# Reproducibility packet inputs: allow only the small processed files used by
# the public worked example.
!data/
!data/README.md
!data/processed/
!data/processed/brady_porotomo_56_1_recovery_descriptors.csv
!data/processed/brady_porotomo_56_1_recovery_fit_curve.csv
!data/processed/brady_porotomo_56_1_alignment_summary.json
!data/provenance/
